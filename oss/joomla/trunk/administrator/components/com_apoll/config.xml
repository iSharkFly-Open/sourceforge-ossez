<?xml version="1.0" encoding="utf-8"?>
<root>
    <params>
		<param type="spacer" default="VOTING FROM COMPONENT" />
			
		<param name="only_registered" type="radio" default="0" label="ONLY REGISTERED" description="ONLY REGISTERED DESC">
			<option value="1">Yes</option>
			<option value="0">NO</option>
		</param>		
		<param name="one_vote_per_user" type="radio" default="1" label="ONE VOTE PER USER" description="ONE VOTE PER USER DESC">
		  <option value="1">Yes</option>
		  <option value="0">NO</option>
		</param>

		<param name="ip_check" type="radio" default="0" label="ONE VOTE PER IP" description="ONE VOTE PER IP DESC">
			  <option value="1">Yes</option>
			  <option value="0">NO</option>
		</param>
	
		<param name="show_component_msg" type="radio" default="1" label="SHOW MSG" description="SHOW MSG DESC">
			<option value="1">Yes</option>
			<option value="0">NO</option>
		</param>
		
		<param name="allow_voting" type="radio" default="1" label="ALLOW VOTING" description="ALLOW VOTING DESC">
			<option value="1">Yes</option>
			<option value="0">NO</option>
		</param>

		<param type="spacer" default="RESULTS" />

		<param name="show_what" type="list" default="1" label="SHOW RESULTS AS" description="SHOW RESULTS AS DESC">
			<option value="0">JOOMLA DEFAULT WAY</option>
			<option value="1">PIE CHART</option>
		</param>
		<param name="show_hits" type="radio" default="1" label="SHOW HITS" description="SHOW HITS DESC">
		  <option value="1">Yes</option>
		  <option value="0">NO</option>
		</param>		
		<param name="show_voters" type="radio" default="1" label="SHOW VOTERS" description="SHOW VOTERS DESC">
		  <option value="1">Yes</option>
		  <option value="0">NO</option>
		</param>
		<param name="show_times" type="radio" default="1" label="SHOW TIMES" description="SHOW TIMES DESC">
		  <option value="1">Yes</option>
		  <option value="0">NO</option>
		</param>		
		<param name="show_dropdown" type="radio" default="1" label="SHOW DROPDOWN" description="SHOW DROPDOWN DESC">
		  <option value="1">Yes</option>
		  <option value="0">NO</option>
		</param>

		
		<param type="spacer" default="PIE OPTIONS" />
		
		
		<param name="opacity" type="text" default="90" label="PIE TRANSPARANCY" description="PIE TRANSPARANCY DESC" size="2" />
		<param name="bg_color" type="text" default="ffffff" label="BACKGROUND COLOR" description="BACKGROUND COLOR DESC" size="6" />
		<param name="circle_color" type="text" default="505050" label="CIRCLE COLOR" description="CIRCLE COLOR DESC" size="6" />
		<param name="pieX" type="text" default="100%" label="PIE WIDTH" description="PIE WIDTH DESC" size="3" />
		<param name="pieY" type="text" default="400" label="PIE HEIGHT" description="PIE HEIGHT DESC" size="3" />
		<param name="start_angle" type="text" default="55" label="START ANGLE" description="START ANGLE DESC" size="3" />
		<param name="radius" type="text" default="150" label="RADIUS" description="RADIUS DESC" size="3" />
		<param name="gradient" type="radio" default="1" label="GRADIENT" description="GRADIENT DESC" size="3">
			<option value="1">Yes</option>
			<option value="0">NO</option>
		</param>		
		<param name="no_labels" type="radio" default="0" label="SHOW LABELS" description="SHOW LABELS DESC" size="3">
			<option value="0">Yes</option>
			<option value="1">NO</option>
		</param>
		<param name="show_zero_votes" type="radio" default="1" label="SHOW ZERO VOTES" description="SHOW ZERO VOTES DESC" size="3">
			<option value="1">Yes</option>
			<option value="0">NO</option>
		</param>
		<param name="animation_type" type="list" default="bounce" label="ANIMATION" description="ANIMATION DESC" size="3">
		<option value="bounce">BOUNCE</option>
		<option value="fade">FADE</option>
		</param>
		<param name="bounce_dinstance" type="text" default="30" label="BOUNCE DINSTANCE" description="BOUNCE DINSTANCE DESC" size="3" />
		<param name="bg_image" type="imagelist" default="0" label="BACKGROUND IMAGE" description="BACKGROUND IMAGE DESC" directory="images/" hide_default ="true" />
		<param name="bg_image_x" type="list" default="left" label="X POSITION" description="X POSITION DESC" size="3">
		<option value="left">LEFT</option>
		<option value="center">CENTER</option>
		<option value="right">RIGHT</option>
		</param>	
		<param name="bg_image_y" type="list" default="top" label="Y POSITION" description="Y POSITION DESC" size="3">
		<option value="top">TOP</option>
		<option value="middle">MIDDLE</option>
		<option value="bottom">BOTTOM</option>
		</param>	
		<param name="font_size" type="text" default="11" label="FONT SIZE OF LABELS" description="FONT SIZE LABELS DESC" size="3" />
		<param name="font_color" type="text" default="404040" label="FONT COLOR OF LABELS" description="FONT COLOR DESC" size="6" />
		<param name="title_lenght" type="text" default="30" label="OPTIONS LENGHT" description="OPTIONS LENGHT DESC" size="3" />

		<param type="spacer" default="JOOMLA DEFAULT WAY" />
				
		<param name="chartX" type="text" default="100%" label="CHART WIDTH" description="CHART WIDTH DESC" size="3" />
		<param name="optionsFontSize" type="text" default="12" label="OPTIONS FONT SIZE" description="OPTION FONT SIZE DESC" size="3" />
		<param name="barHeight" type="text" default="15" label="HEIGHT OF BARS" description="BAR HEIGHT DESC" size="3" />
		<param name="barBorder" type="text" default="1px solid #000000" label="BARBORDER" description="BARBORDER DESC" size="20" />
		<param name="bgBarColor" type="text" default="f5f5f5" label="BGBARCOLOR #" description="BGBARCOLOR DESC" size="6" />
		<param name="bgBarBorder" type="text" default="1px solid #cccccc" label="BGBARBORDER" description="BGBARBORDER DESC" size="20" />
    </params>
</root>